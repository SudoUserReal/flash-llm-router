# ===== docker compose 变量（复制为 .env 后修改）=====

# 数据库凭据（生产环境务必修改密码）
POSTGRES_DB=flash_llm_router
POSTGRES_USER=flr
POSTGRES_PASSWORD=change-me-please

# 应用
APP_PORT=8080
# 首次启动创建的管理员；密码留空则随机生成并打印到日志
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 会话有效期（小时），默认 7 天
SESSION_TTL_HOURS=168
# 统计聚合时区（数据库统一 UTC 存储，聚合与展示按此时区）
STATS_TZ=Asia/Shanghai
# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# ===== 直接运行二进制（非 compose）时的参考 =====
# DATABASE_URL=postgres://flr:change-me-please@localhost:5432/flash_llm_router
